{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cambriks",
          "version": "0.1.0",
          "informationUri": "https://cambriks.example",
          "rules": [
            {
              "id": "APW-DEP-01",
              "name": "APW-DEP-01",
              "shortDescription": {
                "text": "Environment files are never committed"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "deployment",
                "cambriksSeverity": "critical",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Remove the file from git, add it to .gitignore, and rotate every value it contained."
              }
            },
            {
              "id": "APW-SEC-01",
              "name": "APW-SEC-01",
              "shortDescription": {
                "text": "Credentials are never committed to source control"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "security",
                "cambriksSeverity": "critical",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Read the value from process.env at startup and fail fast if it is unset. Rotate the exposed credential."
              }
            },
            {
              "id": "APW-STD-2.4",
              "name": "APW-STD-2.4",
              "shortDescription": {
                "text": "standard-2.4"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "security",
                "cambriksSeverity": "critical",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": null
              }
            },
            {
              "id": "APW-SEC-02",
              "name": "APW-SEC-02",
              "shortDescription": {
                "text": "Database queries are parameterised"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "security",
                "cambriksSeverity": "critical",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Replace the concatenation with a parameterised query using ? placeholders."
              }
            },
            {
              "id": "APW-STD-2.5",
              "name": "APW-STD-2.5",
              "shortDescription": {
                "text": "standard-2.5"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "security",
                "cambriksSeverity": "critical",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": null
              }
            },
            {
              "id": "APW-SEC-03",
              "name": "APW-SEC-03",
              "shortDescription": {
                "text": "Every non-public route enforces authentication server-side"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "security",
                "cambriksSeverity": "critical",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Add requireAuth, and requireSupervisor where the route is administrative, to the route's middleware chain."
              }
            },
            {
              "id": "APW-SEC-05",
              "name": "APW-SEC-05",
              "shortDescription": {
                "text": "Authorisation decisions are not taken from client-controlled state"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "security",
                "cambriksSeverity": "high",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Remove the client-side check and enforce the role on the server for every request."
              }
            },
            {
              "id": "APW-SEC-07",
              "name": "APW-SEC-07",
              "shortDescription": {
                "text": "Accounts are never seeded with a literal password"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "security",
                "cambriksSeverity": "high",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Do not seed accounts outside development. Where seeding is needed, store a salted hash and force a password change on first login."
              }
            },
            {
              "id": "APW-STD-3.2",
              "name": "APW-STD-3.2",
              "shortDescription": {
                "text": "standard-3.2"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "architecture",
                "cambriksSeverity": "high",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": null
              }
            },
            {
              "id": "APW-STD-3.1",
              "name": "APW-STD-3.1",
              "shortDescription": {
                "text": "standard-3.1"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "architecture",
                "cambriksSeverity": "high",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": null
              }
            },
            {
              "id": "APW-DEP-03",
              "name": "APW-DEP-03",
              "shortDescription": {
                "text": "Unhandled errors do not reach the client"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "deployment",
                "cambriksSeverity": "high",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Add app.use((err, req, res, next) => ...) after the routes; log the error and return a generic message."
              }
            },
            {
              "id": "APW-DEP-05",
              "name": "APW-DEP-05",
              "shortDescription": {
                "text": "Credentials are never written to logs"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "pillar": "deployment",
                "cambriksSeverity": "high",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Remove the statement. Never log credential values."
              }
            },
            {
              "id": "APW-BRAND-01",
              "name": "APW-BRAND-01",
              "shortDescription": {
                "text": "Colours come from the approved palette"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "pillar": "brand",
                "cambriksSeverity": "medium",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Replace the literal with the matching var(--apw-*) token."
              }
            },
            {
              "id": "APW-SEC-04",
              "name": "APW-SEC-04",
              "shortDescription": {
                "text": "Untrusted data is not written to the DOM as HTML"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "pillar": "security",
                "cambriksSeverity": "medium",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Build the DOM with createElement and set text via textContent instead of assigning innerHTML."
              }
            },
            {
              "id": "APW-STD-4.1",
              "name": "APW-STD-4.1",
              "shortDescription": {
                "text": "standard-4.1"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "pillar": "correctness",
                "cambriksSeverity": "medium",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": null
              }
            },
            {
              "id": "APW-STD-4.2",
              "name": "APW-STD-4.2",
              "shortDescription": {
                "text": "standard-4.2"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "pillar": "correctness",
                "cambriksSeverity": "medium",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": null
              }
            },
            {
              "id": "APW-DEP-02",
              "name": "APW-DEP-02",
              "shortDescription": {
                "text": "Services expose a health endpoint"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "pillar": "deployment",
                "cambriksSeverity": "medium",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Add GET /health returning 200 with a dependency check."
              }
            },
            {
              "id": "APW-BRAND-03",
              "name": "APW-BRAND-03",
              "shortDescription": {
                "text": "The approved typeface is used throughout"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "pillar": "brand",
                "cambriksSeverity": "low",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Use var(--apw-font)."
              }
            },
            {
              "id": "APW-COR-01",
              "name": "APW-COR-01",
              "shortDescription": {
                "text": "Promise chains handle rejection"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "pillar": "correctness",
                "cambriksSeverity": "low",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Add a .catch() to the chain and surface the failure in the interface."
              }
            },
            {
              "id": "APW-DEP-04",
              "name": "APW-DEP-04",
              "shortDescription": {
                "text": "Services shut down gracefully"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "pillar": "deployment",
                "cambriksSeverity": "low",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Handle SIGTERM: stop accepting connections, drain in-flight requests, close the database."
              }
            },
            {
              "id": "APW-BRAND-02",
              "name": "APW-BRAND-02",
              "shortDescription": {
                "text": "Colours are not hardcoded in inline styles"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "pillar": "brand",
                "cambriksSeverity": "low",
                "policyPack": "apw-baseline-v1@1.0",
                "remediation": "Move the declaration into a class in the stylesheet and use a token."
              }
            }
          ]
        },
